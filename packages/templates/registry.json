      "dependencies": ["lucide-react", "motion", "next-themes"],
      "registryDependencies": [
        "avatar",
        "breadcrumb",
        "button",
        "collapsible",
        "dropdown-menu",
        "input",
        "kbd",
        "separator",
        "sidebar",
        "skeleton"
      ],
      "files": [
