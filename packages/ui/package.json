{
  "name": "@ugolin-olle/ui",
  "version": "0.1.0",
  "description": "React components and blocks for shadcn/ui, by Ugolin Ollé. Install via npm or copy the source with the shadcn CLI.",
  "keywords": [
    "components",
    "react",
    "shadcn",
    "shadcn-ui",
    "tailwindcss",
    "ui"
  ],
  "homepage": "https://ugolin-olle.com/ui",
  "bugs": "https://github.com/UgolinOlle/portfolio-v0/issues",
  "license": "MIT",
  "author": "Ugolin Ollé",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UgolinOlle/portfolio-v0.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "require": {
        "types": "./dist/*.d.cts",
        "default": "./dist/*.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run registry:generate && tsup",
    "check-types": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "prepublishOnly": "bun run build",
    "registry:build": "bun run registry:generate && shadcn build --output ../../apps/web/public/r",
    "registry:generate": "bun scripts/registry.ts && oxfmt --write registry.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@portfolio-v0/activity": "workspace:*",
    "@portfolio-v0/avatars": "workspace:*",
    "@portfolio-v0/blog": "workspace:*",
    "@portfolio-v0/button": "workspace:*",
    "@portfolio-v0/button-apple": "workspace:*",
    "@portfolio-v0/button-gandi": "workspace:*",
    "@portfolio-v0/button-shopify": "workspace:*",
    "@portfolio-v0/calendar-sync": "workspace:*",
    "@portfolio-v0/config": "workspace:*",
    "@portfolio-v0/cta-simple": "workspace:*",
    "@portfolio-v0/headers": "workspace:*",
    "@portfolio-v0/input": "workspace:*",
    "@portfolio-v0/landing-saas": "workspace:*",
    "@portfolio-v0/shadcn": "workspace:*",
    "@portfolio-v0/shortcut": "workspace:*",
    "@portfolio-v0/status-card": "workspace:*",
    "@portfolio-v0/usage-card": "workspace:*",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4.2.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
