{
  "name": "portfolio-v0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^25.6.0",
      "typescript": "^6.0.3",
      "motion": "^12.43.0",
      "lucide-react": "^1.27.0",
      "class-variance-authority": "^0.7.1",
      "@radix-ui/react-slot": "^1.2.4",
      "tailwindcss": "^4.2.4",
      "shadcn": "^4.7.0",
      "@base-ui/react": "^1.6.0",
      "clsx": "^2.1.1",
      "tailwind-merge": "^3.5.0",
      "next-themes": "^0.4.6"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "check": "oxlint && oxfmt --write",
    "format": "oxfmt --write",
    "prepare": "husky",
    "bump-deps": "bunx npm-check-updates --deep -u -x shiki,next,recharts,require-in-the-middle && node scripts/bump-catalog.mjs && bun install",
    "bump-ui": "bunx shadcn@latest add --all --overwrite -c packages/shadcn && bunx shadcn@latest migrate base-ui -c packages/shadcn",
    "clean": "turbo clean && git clean -xdf node_modules .cache .turbo dist",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@portfolio-v0/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": [
      "oxlint --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "bun@1.4.2"
}
