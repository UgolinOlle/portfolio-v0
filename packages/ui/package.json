{
  "name": "@whoa-studio/ui",
  "version": "0.1.0",
  "description": "Base UI components styled with Tailwind v4, the shadcn/ui set as a versioned npm package.",
  "keywords": [
    "base-ui",
    "components",
    "react",
    "shadcn",
    "shadcn-ui",
    "tailwindcss",
    "ui"
  ],
  "homepage": "https://github.com/UgolinOlle/portfolio-v0/tree/stable/packages/ui#readme",
  "bugs": "https://github.com/UgolinOlle/portfolio-v0/issues",
  "license": "MIT",
  "author": "Ugolin Ollé",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UgolinOlle/portfolio-v0.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "require": {
        "types": "./dist/*.d.cts",
        "default": "./dist/*.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "lint:package": "publint && attw --pack . --profile node16 --exclude-entrypoints ./styles.css",
    "prepublishOnly": "bun run build",
    "registry:build": "bun run registry:generate && shadcn build --output ../../apps/web/public/r",
    "registry:generate": "bun scripts/registry.ts && oxfmt --write registry.json",
    "test:smoke": "bun run build && bun test smoke"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next-themes": "catalog:",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.11.0",
    "recharts": "3.8.0",
    "shadcn": "catalog:",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@portfolio-v0/activity": "workspace:*",
    "@portfolio-v0/ascii-black-hole": "workspace:*",
    "@portfolio-v0/avatars": "workspace:*",
    "@portfolio-v0/blog": "workspace:*",
    "@portfolio-v0/button": "workspace:*",
    "@portfolio-v0/button-apple": "workspace:*",
    "@portfolio-v0/button-gandi": "workspace:*",
    "@portfolio-v0/button-shopify": "workspace:*",
    "@portfolio-v0/calendar-sync": "workspace:*",
    "@portfolio-v0/command-search": "workspace:*",
    "@portfolio-v0/config": "workspace:*",
    "@portfolio-v0/cta-simple": "workspace:*",
    "@portfolio-v0/dream-sky": "workspace:*",
    "@portfolio-v0/headers": "workspace:*",
    "@portfolio-v0/hero-sky": "workspace:*",
    "@portfolio-v0/input": "workspace:*",
    "@portfolio-v0/kanban": "workspace:*",
    "@portfolio-v0/landing-saas": "workspace:*",
    "@portfolio-v0/shadcn": "workspace:*",
    "@portfolio-v0/shortcut": "workspace:*",
    "@portfolio-v0/status-card": "workspace:*",
    "@portfolio-v0/usage-card": "workspace:*",
    "@portfolio-v0/world-clock": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "publint": "^0.3.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsup": "^9.0.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
